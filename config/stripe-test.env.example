# Copy these variables into your local .env and provide YOUR Stripe sandbox keys.
# Payment Element uses Stripe.js with this pk_test_ public key. Card fields
# stay inside Stripe's secure iframe. Never use live keys here.
APP_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Demonstration conversion only, not a current market exchange rate.
STRIPE_TEST_CURRENCY=eur
STRIPE_TEST_EXCHANGE_RATE=0.30
